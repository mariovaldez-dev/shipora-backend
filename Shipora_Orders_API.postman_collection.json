            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originCountry\": \"MX\",\n  \"originCity\": \"Mexico City\",\n  \"destinationCountry\": \"US\",\n  \"destinationCity\": \"Los Angeles\",\n  \"weight\": 0.5,\n  \"length\": 20,\n  \"width\": 15,\n  \"height\": 10,\n  \"declaredValue\": 100,\n  \"requestDuration\": 245,\n  \"quotes\": [\n    {\n      \"carrier\": \"paquete-express\",\n      \"serviceName\": \"Express Overnight\",\n      \"estimatedDays\": 1,\n      \"price\": 45.50,\n      \"currency\": \"USD\"\n    },\n    {\n      \"carrier\": \"estafeta\",\n      \"serviceName\": \"Standard\",\n      \"estimatedDays\": 3,\n      \"price\": 28.75,\n      \"currency\": \"USD\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders/rates/query",
              "host": ["{{base_url}}"],
              "path": ["orders", "rates", "query"]
            }
          }
        },
