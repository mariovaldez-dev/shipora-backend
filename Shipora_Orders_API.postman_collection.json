              "host": ["{{base_url}}"],
              "path": ["orders", "rates", "history"],
              "query": [
                {
                  "key": "limit",
                  "value": "100"
                },
                {
                  "key": "skip",
                  "value": "0"
                }
              ]
            }
          }
        }
      ]
