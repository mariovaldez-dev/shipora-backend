# .env.example - Firebase Storage Configuration

# ==================== DATABASE ====================
DB_URI=mongodb://localhost:27017/shipora
# Or MongoDB Atlas:
# DB_URI=mongodb+srv://user:password@cluster.mongodb.net/shipora?retryWrites=true&w=majority

# ==================== JWT ====================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# ==================== FIREBASE STORAGE ====================
# 1. Get these from Firebase Console > Settings > Service Accounts > Generate Private Key

# Your Firebase Project ID
FIREBASE_PROJECT_ID=your-project-id

# Your Firebase Storage Bucket (from Firebase Console)
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Your Firebase Service Account Key (entire JSON as string)
# Important: Keep this as a single-line JSON string in .env
# Get from: Firebase Console > Settings > Service Accounts > Generate Private Key
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project-id","private_key_id":"abcd1234","private_key":"-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC7VJTUt9Us8cKj\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-abc123@your-project.iam.gserviceaccount.com","client_id":"123456789","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-abc123%40your-project.iam.gserviceaccount.com"}'

# ==================== ENCRYPTION ====================
# Generate a secure 32-byte encryption key (256-bit):
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 
# IMPORTANT: 
# - Must be exactly 64 hex characters (32 bytes)
# - Never change this after storing encrypted documents
# - Keep this secret!
ENCRYPTION_KEY=your-64-character-hex-string-here-must-be-exactly-32-bytes

# ==================== APPLICATION ====================
PORT=3000
NODE_ENV=development

# Storage provider to use for documents. Options:
# - FIREBASE: store in Firebase Storage (requires service account and may require card for project)
# - GRIDFS: store in MongoDB GridFS (free if you already run MongoDB)
# - S3: AWS S3
# For a free option (no credit card), set to GRIDFS
STORAGE_PROVIDER=GRIDFS
# ==================== LOGGING ====================
LOG_LEVEL=debug

# ==================== CARRIERS ====================

# Paquete Express
PQX_URL_PDF=https://api.paqueteexpress.com
PQX_USER=your-paquete-express-user
PQX_PASSWORD=your-paquete-express-password
PQX_CLIENT=your-paquete-express-client-number

# FedEx
FEDEX_API_URL=https://apis-sandbox.fedex.com
# FEDEX_API_URL=https://apis.fedex.com  # Production
FEDEX_API_KEY=your-fedex-api-key
FEDEX_SECRET_KEY=your-fedex-secret-key
FEDEX_ACCOUNT_NUMBER=your-fedex-account-number
FEDEX_METER_NUMBER=your-fedex-meter-number

# DHL Express
DHL_API_URL=https://express.api.dhl.com/mydhlapi/test
# DHL_API_URL=https://express.api.dhl.com/mydhlapi  # Production
DHL_API_KEY=your-dhl-api-key
DHL_API_SECRET=your-dhl-api-secret
DHL_ACCOUNT_NUMBER=your-dhl-account-number

# Estafeta (Coming Soon)
# ESTAFETA_API_URL=
# ESTAFETA_USER=
# ESTAFETA_PASSWORD=

# UPS (Coming Soon)
# UPS_API_URL=
# UPS_USERNAME=
# UPS_PASSWORD=
# UPS_ACCESS_KEY=

# ==================== REDIS ====================
REDIS_HOST=localhost
REDIS_PORT=6379
